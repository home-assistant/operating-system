BOARD_ID="rock5b"
BOARD_NAME="Rock5b"
CHASSIS=embedded
BOOTLOADER=uboot
KERNEL_FILE=Image
PARTITION_TABLE_TYPE=gpt
BOOT_SIZE=24M
BOOT_SPL=true
BOOT_SPL_SIZE=8M
BOOT_ENV_SIZE=0x8000
SUPERVISOR_MACHINE=qemuarm-64
SUPERVISOR_ARCH=aarch64

HASSOS_ID="hassos"
HASSOS_NAME="Home Assistant OS"
DEPLOYMENT="production"
DISK_SIZE=2G

# ----------------------------
# ROCKCHIP (recommended, vendor dtb)
# ----------------------------
# upstream rockchip kernel and u-boot repositories (tarballs)
ROCKCHIP_KERNEL_TARBALL="https://github.com/rockchip-linux/kernel/archive/refs/heads/develop-6.1.tar.gz"
ROCKCHIP_UBOOT_TARBALL="https://github.com/rockchip-linux/u-boot/archive/refs/heads/next-dev.tar.gz"
# Example dtb name expected from kernel build (verify in the kernel arch/arm64/boot/dts/rockchip/)
ROCKCHIP_DTB_NAME="rk3588-rock-5b.dtb"

# ----------------------------
# ARMBIAN vendor
# ----------------------------
# Armbian keeps kernel sources and patches in their repos. You can use Armbian's kernel
# tree as a tarball; below are example tarballs (branch names may change).
ARMBIAN_KERNEL_TARBALL="https://github.com/armbian/linux-rockchip/archive/refs/heads/rk-6.1-rkr5.1.tar.gz"
ARMBIAN_UBOOT_TARBALL="https://github.com/armbian/u-boot/archive/refs/heads/master.tar.gz"
# Armbian-derived dtb name (verify after build/patching)
ARMBIAN_DTB_NAME="rk3588-rock-5b.dtb"

# ----------------------------
# Collabora - Release branch
# ----------------------------
# tree as a tarball; below are example tarballs (branch names may change).
COLLABORA_KERNEL_TARBALL="https://gitlab.collabora.com/hardware-enablement/rockchip-3588/linux/-/archive/rockchip-v7.0/linux-rockchip-v7.0.tar.gz"
COLLABORA_UBOOT_TARBALL="https://gitlab.collabora.com/hardware-enablement/rockchip-3588/u-boot/-/archive/v2026.01/u-boot-v2026.01.tar.gz"
# Collabora-derived dtb name (verify after build/patching)
COLLABORA_DTB_NAME="rk3588-rock-5b.dtb"

# ----------------------------
# Default selection (change to ARMBIAN_* if you want Armbian)
# ----------------------------
# Set KERNEL_TARBALL_URL and UBOOT_TARBALL_URL to the desired sources.
KERNEL_TARBALL_URL="${COLLABORA_KERNEL_TARBALL}"
#UBOOT_TARBALL_URL="${COLLABORA_UBOOT_TARBALL}"
DTB_NAME="${COLLABORA_DTB_NAME}"

# Kernel version hint (for docs / scripts)
KERNEL_VERSION_HINT="7.x"
