BR2_aarch64=y
BR2_cortex_a76_a55=y

BR2_TARGET_GENERIC_HOSTNAME="rock5b"
BR2_TARGET_GENERIC_ISSUE="Welcome to the rock5b board"

# Toolchain
BR2_TOOLCHAIN_BUILDROOT_CXX=y
#BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
#BR2_TOOLCHAIN_BUILDROOT_GLIBC_VARIANT="glibc"
#BR2_TOOLCHAIN_EXTERNAL=y

# Init system
BR2_INIT_SYSTEMD=y
#BR2_SYSTEMD_SECONDS=0

# container runtime used by hassos (containerd)
BR2_PACKAGE_CONTAINERD=y

# RAUC for OTA (hassos uses rauc)
BR2_PACKAGE_RAWSRC_RAUCPKG=y
# If a rauc package exists in your buildroot-external, enable it instead. This is a placeholder.

# Kernel build: custom tarball from meta
BR2_LINUX=y
BR2_LINUX_KERNEL_CUSTOM=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="${KERNEL_TARBALL_URL}"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
# If you have a kernel defconfig inside board/radxa/rock5b/, set:
# BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="board/radxa/rock5b/linux_defconfig"

# Filesystems / images
BR2_TARGET_ROOTFS_EXT4=y
BR2_TARGET_ROOTFS_TAR=y
# Basic packages often required by hassos
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_PYTHON3_PIP=y
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_DBUS=y
BR2_PACKAGE_UTILLINUX=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_SHADOW=y
BR2_PACKAGE_NETWORKMANAGER=y

# Board package marker so external scripts can detect it
BR2_PACKAGE_BOARD_ROCK5B=y

# Minimal host utilities
BR2_PACKAGE_BASH=y
BR2_PACKAGE_BUSYBOX_CONFIG=y
