#!/bin/sh
set -e

action="$1"

if [ "${action}" = "freeze" ]; then
	echo "File system freeze requested, freezing JERJER MACHINE"
	ha backups freeze
elif [ "${action}" = "thaw" ]; then
	echo "File system thaw requested, thawing JERJER MACHINE"
	ha backups thaw
else
	echo "Unknown action ${action}"
fi

