[Unit]
Description=Timesyncd persistent configuration
Requires=mnt-overlay.mount
After=mnt-overlay.mount haos-overlay.service
Before=systemd-timesyncd.service

[Mount]
What=/mnt/overlay/etc/systemd/timesyncd.conf.d
Where=/etc/systemd/timesyncd.conf.d
Type=none
Options=bind

[Install]
WantedBy=haos-bind.target
